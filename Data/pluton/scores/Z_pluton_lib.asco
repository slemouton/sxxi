 ;pluton lib utility functions

 @macro_def @pluton_note($notename,$vel,$dur)
    {
        if ($notename != "0")
         {
			//	print $notename,@symb2midicent($notename)
			tnote $notename $vel $dur			;conversions in MAX
			@makenote (tnote2,@/(@symb2midicent($notename),100),$vel,$dur)
     	}  
     }

 @macro_def @makenote($name, $p, $vel, $dur) 
          { 
              print 'makenote',$name,$p,$vel
                group myMakenote
               {
                        $name $p $vel 
                   $dur $name $p 0
               }
          }   

@proc_def pluton_chord($notelist,$vel,$dur)
    {
        forall $notename in $notelist
         {
            tnote $notename $vel $dur           ;conversions in MAX
            @makenote (tnote2,@/(@symb2midicent($notename),100),$vel,$dur)
        }  
     }

@proc_def pluton_chord_s($notelist,$vel,$dur)
    {
        $scrambledeggs := @scramble($notelist)
        print $scrambledeggs
        forall $notename in $scrambledeggs
         {
            tnote $notename $vel $dur           ;conversions in MAX
            @makenote (tnote2,@/(@symb2midicent($notename),100),$vel,$dur)
        }  
     }

whenever ($alea_chord)
{
    $chord_number := @rand_int(14)
    print accordaleatoire $chord_number
    switch ($chord_number)
    {
        case 0:
            ::pluton_chord_s (["E3", "Gb3", "Eb4", "G4", "C5", "D5", "Ab5"],110,(8/15)) 
        case 1:
            ::pluton_chord_s (["Bb1", "D2", "Gb2", "A2", "B2", "E3", "Gb3", "C4", "Eb4"],110,(8/15)) 
        case 2:
            ::pluton_chord_s (["Bb3","C4", "Db4", "Eb4", "A4","B4", "D5", "Ab5", "E6"],110,2/3) 
        case 3:
            ::pluton_chord_s (["Bb4","Eb5", "F5", "A5", "C6","D6", "Gb6","Ab6","Db7" ],110,2/3) 
        case 4:
            ::pluton_chord_s (["C#3","E3","F#3","A3","B3","F4","G4","Bb4","C5"],110,2/3) 
        case 5:
            ::pluton_chord_s (["D2","F2","G2","A2","C3","D#3","F#3","G#3","A#3","C#4"],110,8/15) 
        case 6:
            ::pluton_chord_s (["F#3","G#3","C#4","F4","G4","C5","D5","Eb5","A5","B5"],110,8/15) 
        case 7:
            ::pluton_chord_s (["F3","G3","C#4","D#4","F#4","G#4"],110,8/15)     
        case 8:
            ::pluton_chord_s (["Bb1","Eb2","A2","B2"],110,8/15) 
        case 9:
            ::pluton_chord_s (["F1","G1","B1","D3","Eb3","F#3","G#3","C#4"],110,8/15) 
        case 10:
            ::pluton_chord_s (["Ab1","Bb1","Eb2","A2","B2","F3","G3","C#4","F#4"],110,8/15) 
        case 11:
            ::pluton_chord_s (["A2","C3","D3","B3","F4","G4","C#5","E5","F#5","G#5"],110,8/15) 
        case 12:
            ::pluton_chord_s (["G#4","B4","C#5","F5","A5","B5","D6","E6","F#6","Bb6"],110,8/15) 
        case 13:
            ::pluton_chord_s (["D#2","F#2","D3","F3","G3","C4"],110,8/15) 
    }
}


@proc_def midi_player($midi)
// midi file player
{
    $index := 0
    $period := $midi[$index, 0]
    Loop $period
    {
      ForAll $e in $midi[$index, 1]
      {
          maxmidi $e
      }
      $index := $index + 1
      if ($index < @size($midi)) { $period := $midi[$index, 0] }
      } while ($index < @size($midi))
}
