@INSERT "macros_def.asco"	; definition des fonctions et macros
	
; antescofo-mess temposmoothness 0.1 ; is now obsolete, please check at https://antescofo-doc.ircam.fr/Reference/tempo_inference/ if you need to deal with tempo inference

antescofo-mess tempo  63 
antescofo-mess tune 442
antescofo-mess analysis 2048 256
;	BPM 46

TEMPO ON
deltas_pm.pgm 20
;master 100 

	fx_pgm 1	; matrice a zero  

	;String Init	
	s_loop 0
	s_stop bang ; arrete le string

	stosp3 0		; string > spat1  
	spat3_traj 0 
	stosp1 120		; string > spat1  
	string1 75 		; was string before 
	s_tempo 251
	spat1 100  
	spat3 0
	s_reset bang	; reset string parameters  
	h1 86
	h2 86
	h3 86
	stoh1 106
	stoh2 106
	stoh3 106
	
	;Synful Init	
	syn_voices 4 72 0;
	syn_voices 4 64 0;
	   
	syn_voices 1 flush 1; turn notes off 
	syn_voices 2 flush 1; turn notes off 
	Bsyn_voices 1 flush 1; turn notes off 
	Bsyn_voices 2 flush 1; turn notes off 
	Bsynful_flush bang;
	bouge 0				; bouge les spats aleatoire 
	
	; Set initial pitch bends
	syn_voices 1 xbend 0; 
	syn_voices 2 xbend 0; 
	syn_voices 3 xbend 0; 
	syn_voices 4 xbend 0; 
	syn_voices 5 xbend 0;  
	; synful_vst read strings-ctls4.fxb 
 
	; set initial vibratos on available channels
	syn_voices 3 vibrato 0.2, 4 vibrato 0.2, 5 vibrato 0.2, 6 vibrato 0.2	; etc  
	syn_voices 9 pgm 40 bnk 2 vol 127  ; pizz solo
	syn_voices 10 pgm 40 bnk 2 vol 127;
;	init_syn_voices_expr bang

	sampler2 100 
	smp2tosp2 100 

	smp1tosp2	120 
	spat1		100 
	spat2		100 
	spat3		100 
	; spat4		100 
	sampler1	100
	h0	100 
	h1	100 
	h2	100 
	h3	100 
	h4	100 

	master_toupie_freq 0
	h1_leslie_mode 0 
	h2_leslie_mode 0 
	h3_leslie_mode 0 
	h4_leslie_mode 0 

	Bsynful 70	;95		; Volume en DB 
	synful 70 	;95		; volume synful et spat1 en DB 
	
	3fc_mode off
	3fc 0		
	3fc_1 87
	3fc_2 87
	3fc_3 87	

; *********
; SPAT INIT
; *********
spat1_dist 1
spat2_dist 1
spat3_dist 1
spat1_pres 90
spat3_pres 90
spat2_pres 90


	spat1_aperture 20
	spat2_aperture 20
	spat3_aperture 20	
	spat1_az 0 ; front
	;spat1_dist 5; 5 m
	spat1_width 30
	
	spat1_rev 55
	spat1_traj 0
	
	spat2_az 0 ; front
	;spat2_dist 5; 5 m
	spat2_width 30
	;spat2_aperture 20; 5 
	spat2_traj 0
	
	
	spat3_az 1 ; 
	spat3_dist 1.5;
	spat3_pres 90;
	spat3_prer 80;
	spat3_width 30
	spat3_rev 60;
	spat3_aperture 30
	spat3_width 30
	spat3_dopp 0	
	s2tohp3 0

;**************************************************************	
;**************************************************************	
;**************************************************************	
 
TRILL (Eb6 D6) 4 ev2.1 
antescofo-mess tempo  63

suivi 1

syntosp3 101
synful 0, 60 0.3;
syn_voices 1	pgm 0 bnk 2 vol 120 "expr" 75; pizz ensemble tutti
syn_voices 2	pgm 0 bnk 2 vol 120 "expr" 75; pizz
syn_voices 9 pgm 40 bnk 2 vol 80 "expr" 75;
syn_voices 10 pgm 40 bnk 2 vol 80 "expr" 75;
synful_pizz_tutti 0	
pitch-syn_voice1 87
pitch-syn_voice2 86

	sy1_ P2_SY1_2.01.aif
	
$tempo_a := 63
$tempo_flag := 0

;LFWD loop2_2 1 @tempo:=($tempo_flag== 0? 63 : $RT_TEMPO) 
;LFWD	loop2_2 1 @tempo 63
LFWD loop2_2 1  @tempo:=$tempo_a
	{
		pizz-loop2-2a bang
		pizz-loop2-2b bang
	}
	
2 synful 60 @b(2)
synful_pizz_tutti 0,127 5000
NOTE 0 3.000 
CHORD (D6 Eb6) 0.3
NOTE 0 0.3
CHORD (D6 Eb6) 0.3
NOTE 0 1
CHORD ( 68 71 ) 0.4 ev2.2
cue_dur 2 ; 2 temps entre 2.2 et 2.3
TEMPO OFF
	read_traj cercle.traj

	GFWD cercle-lent 
	{	
		0.2	spat3_traj_loop 1; 
			traj_spat1 1 traj @b(20) 13 ; on/off, nom de la trajectoire ,duree de la boucle, distance		
	}	
