CHORD ( 65 71 ) 2.000 ev2.3	

	;	read_traj1	traj1_evt2.traj ; lit une trajectoire implicitement dans traj2.traj		
	s_force_scale 3.82; 
	s_vel_scale 4.88;
	s_dist_scale 1.64;
	s_trans_scale 0;
	
	s_loop 1;
	s_pitch 68.; 
	s_sel_end 922.;
	s_sel_start 90.;
	;s_speed 0.14; 
	;s_tempo 21
	tempo_to_s bang ; tempo calcule en fonction de la duree du cue
	tempoB 48 ;tempo theorique B1
	string1 0, 91 @b(1)
	s_dur 2
	synful 56
	
	spat1_rev 45
	spat1_pres 44
	spat1_prer 100
	stosp1 68, 78 3000
	s_start bang

	st1_ P2_ST1_2.03.aif

	group 		harm ; 2.1
	{
	h1_trans 300
	h2_trans -700
	h3_trans -1000 ; 
	h0 0
	h1 72
	h2 67
	h3 67
	h4 0
	stoh1 113
	stoh2 113
	stoh3 113
	stoh4 0
	h1tosp1 68, 90 3000
	h2tosp1 68, 98 3000
	h3tosp1 75, 90 3000
	}

