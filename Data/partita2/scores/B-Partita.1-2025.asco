NOTE 92 0.250 ev1-1

suivi 1
antescofo-mess tempo  63

	syntosp1 101
	synful 0, 40 0.3;
	syn_voices 1	pgm 40 bnk 5 vol 120		; vlon trem
	syn_voices 1 92 127 
	
	;	read_traj1	traj1_evt2.traj ; lit une trajectoire implicitement dans traj2.traj
	read_traj cercle.traj
	;	traj1_dist 3
	spat1_traj_loop 1
	 
	sy1_ P2_SY1_1.01.aif

	GFWD cercle-lent 
	{
	
		0.2	spat3_traj_loop 1; 
			traj_spat1 1 traj @b(20) 1 ; on/off, nom de la trajectoire ,durée de la boucle, distance
		
	}
	
		spat1_aperture 140
		3fc_boost 100

