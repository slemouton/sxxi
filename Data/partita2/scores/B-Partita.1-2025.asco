@INSERT "macros_def.asco"	; definition des fonctions et macros
	
; antescofo-mess temposmoothness 0.95 ; is now obsolete, please check at https://antescofo-doc.ircam.fr/Reference/tempo_inference/ if you need to deal with tempo inference

antescofo-mess tune 442
antescofo-mess analysis 4096 512
antescofo-mess tempo  63 

obs_gate 1 ;  observation input on
deltas_pm.pgm 20
; monitors.pgm 1 ; all off
; direct_out.pgm 1

master 100 
	
suivi 0
TEMPO ON
	
	samplors_ stopall 10

	fx_pgm 1	; matrice à zero  
	
	s_loop 0
	s_stop bang ; arrete le string
	; s_config 1;

	stosp3 0		; string > spat1  

	; routing
	stosp1 120		; string > spat1  
	string1 75 		; was string before 
	s_tempo 251
	s_reset bang	; reset string parameters  
	h1 86
	h2 86
	h3 86
	
	; arrête synful lorsqu'on reprend la séquenceau début
	syn_voices 4 72 0;
	syn_voices 4 64 0;
	   
	syn_voices 1 flush 1; turn notes off 
	syn_voices 2 flush 1; turn notes off 
	Bsyn_voices 1 flush 1; turn notes off 
	Bsyn_voices 2 flush 1; turn notes off 

	bouge 0				; bouge les spats aleatoire 
		
	;init synful
	; Set initial pitch bends
	syn_voices 1 xbend 0; 
	syn_voices 2 xbend 0; 
	syn_voices 3 xbend 0; 
	syn_voices 4 xbend 0; 
	syn_voices 5 xbend 0;  
	
	; synful_vst read strings-ctls4.fxb 
		 
	 ; set initial vibratos on available channels
	syn_voices 3 vibrato 0.2, 4 vibrato 0.2, 5 vibrato 0.2, 6 vibrato 0.2	; etc  
	
					
	sampler1_ adsr 2 2 100 5
	sampler2_ adsr 2 2 100 5
	
	sampler1	112
	smp1tosp2	115
	sampler2 112 
	smp2tosp3 115

	h0	100 
	h1	100 
	h2	100 
	h3	100 
	h4	100 

	master_toupie_freq 0
	h1_leslie_mode 0 
	h2_leslie_mode 0 
	h3_leslie_mode 0 
	h4_leslie_mode 0 
	
	Bsynful 0			; Volume en DB 
	synful 0 			; volume synful et spat1 en DB 
	;;;;;;;;;;;;;;;;;;
	; 3fc synthesis parameters
	
	3fc 0
	3fc_mode off
	3fctosp1 0
	3fctosp2 0
	
	v1_minpower 39	; 0-100 seuil energie faible=bcp activite eleve=peu activite
	v1_stable_time 39	; en ms seuil temporel faible=bcp activite eleve=peu activite
	v1_vibrato 0.47 ; en demi-ton pour considerer le vibrato
	v1_sigmund_trans 0 ; transposition en demi-ton	
	v2_sigmund_trans 0 ; transposition en demi-ton	
	v3_sigmund_trans 0 ; transposition en demi-ton
;	s1_sigmund_trans 0 ; transposition en demi-ton
;	s2_sigmund_trans 0 ; transposition en demi-ton	
	3fc_ph_mfreq 0	; phasing à zéro
	3fc_ph_mix 0
	3fc_fl_freq 0 ; flanger à zéro
	3fc_fl_del 0
	3fc_fl_fback 100
	3fc_fl_mix 100
	v1_sigmund 1
;	s1_sigmund 0
;	s2_sigmund 0
	3fc_attack 73 ; ms
	3fc_time_length 35 ; constante de temps 1(tres court)-100(très long) 
	3fc_proba 11; proba spectre faible=varié fort=fixe
	3fc_max_freqs 1; nombre de partiels	
	3fc_amp_jitter 0	; porba pour avoir des différences d'amplitudes entre les partiels
	3fc_mode off

; *********
; SPAT INIT
; *********

		spat1_az 0 ; front
		;spat1_dist 5; 5 m
		spat1_width 30
		spat1_rev 55
		spat1_traj 0
	    spat1_aperture 20
		
		spat2_az 1 ; 
		spat2_dist 0.8;
		spat2_pres 85;
		spat2_prer 95;
		spat2_width 30
		spat2_rev 50;
		spat2_aperture 120
		spat2_width 30
		spat2_dopp 0
		spat2_traj 0
		
		
		spat3_az 1 ; 
		spat3_dist 1.5;
		spat3_pres 90;
		spat3_prer 80;
		spat3_width 30
		spat3_rev 70;
		spat3_aperture 30
		spat3_width 30
		spat3_dopp 0
		spat3_traj 0 
	
	
		spat1 100 
		spat2 100 
		spat3 100
		
		syn_voices 1	pgm 40 bnk 5 vol 127		; vlon trem
				
	v1_sigmund_trans 0 ; transposition en demi-ton	
	v2_sigmund_trans 0 ; transposition en demi-ton	
	v3_sigmund_trans 0 ; transposition en demi-ton
;	v1_sigmund_del 0 ; delai en ms	
;	v2_sigmund_del 0 
;	v3_sigmund_del 0 	

	 print "Press space to start"  

