	; sigmund parameters
	v1_minpower 20	; 0-100 seuil energie faible=bcp activite eleve=peu activite
	v1_stable_time 40	; en ms seuil temporel faible=bcp activite eleve=peu activite
	v1_vibrato 0.47 ; en demi-ton pour considerer le vibrato
	v1_sigmund_trans 0 ; transposition en demi-ton	
	v2_sigmund_trans 4 ; transposition en demi-ton	
