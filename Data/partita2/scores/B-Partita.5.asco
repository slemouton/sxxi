	s1_sigmund_trans 0 ; transposition en demi-ton	
	s2_sigmund_trans 0 ; transposition en demi-ton	

	; 3fc synthesis parameters 
	3fc_attack 11 		; ms
	3fc_time_length 40	; constante de temps 1
	3fc_proba 1	; proba spectre
	3fc_amp_jitter 50	; porba pour avoir des
	3fc_ph_mfreq 0
	3fc_ph_mix 0
	3fc_fl_freq 0 ; flanger
	3fc_fl_del 0
	3fc_fl_fback 100
	3fc_fl_mix 100
	3fc_max_freqs 6

	; start sigmund analysis
	v1_sigmund 0
	s1_sigmund 0
	s2_sigmund 0	
	
