	; reset strings 
	string1 0
	s2 0

	bouge 0   
	
	; reset sigmund	
	v1_sigmund 0
	v2_sigmund 0
	al_sigmund 0
	cl_sigmund 0
;	v1toh0 0
	v1toh1 0
	v1toh2 0
	v1toh3 0
	v1toh4 0
	v1torev 0
