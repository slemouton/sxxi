	3fctohp2 0
	3fctohp3 0
	3fctohp4 0
	3fctohp5 0
	3fctohp6 0
	
	; *************
	; sons
	; *************
	son1 loop 1, 0
	son2 loop 1, 0
	son3 loop 1, 0
	
	
	; *************
	; spats
	; *************
		
		to_spats reset

		/*
		1	spat1_ctl bang   
		print "spat1 reset done"   
		1	spat2_ctl bang   
		print "spat2 reset done"   
		1	spat3_ctl bang   
		print "spat3 reset done" 
		*/
		
		1 print "Updating Concert Hall Settings ..."   
		
		;print "center set to 0.001 to avoid jump"    
	 	;print "Studio 2 Spat Reverb settings"   
		spat1_ctl radius 0.1, width 20, fact warm 30, fact bril 30, fact prer 48, fact revp 46, fact env 39, fact rev 59, fact heav 21, fact live 19, source air 0, source Dopp 0   
		spat2_ctl radius 0.1, width 20, fact warm 30, fact bril 30, fact prer 48, fact revp 46, fact env 39, fact rev 59, fact heav 21, fact live 19, source air 0, source Dopp 0   
		spat3_ctl radius 0.1, width 20, fact warm 30, fact bril 30, fact prer 48, fact revp 46, fact env 39, fact rev 59, fact heav 21, fact live 19, source air 0, source Dopp 0   

		; 1	print "Studio 2 Corners position"   
	 	spat1_ctl corners 35 -35 -145 145 , speedlim 30, DISPLAY 1   
	 	spat2_ctl corners 35 -35 -145 145 , speedlim 30, DISPLAY 1   
	 	spat3_ctl corners 35 -35 -145 145 , speedlim 30, DISPLAY 1   
	 	
	 	; une initialisation des spats car bug du reset sur la presence
	 	
	 	; init spat1
	 	/*
		spat1_dist_min 0.5
		spat1_dist 1	; cette distance est fondamentale pour le niveau, l'altérer revient à modifier tous les niveaux
		spat1_az 0
		spat1_pres 90	; idem pour la presence, la distance et la presence sont liés dans le spat
		spat1_prer 80 ; spat1_ctl fact prer 80
		spat1_revp 30
		spat1_env 19
		spat1_rev 80
		spat1_aperture 30
		spat1_width 30
		spat1_dopp 0
		*/
		
		spat1_ctl radius 0.1, dist_min 0.5, aperture 30, width 30, warm 30,  bril 30,  prer 80,  revp 30,  env 19,  rev 90,  heav 21,  live 19,  air 0,  doppler 0, az 0, dist 1, pres 90  
		
		
		; reglage spat2
		/*
		spat2_dist_min 0.5
		spat2_dist 1
		spat2_az  30
		spat2_pres 90
		spat2_prer 80 ; spat1_ctl fact prer 80
		spat2_revp 30
		spat2_env 19
		spat2_rev 80
		spat2_aperture 30
		spat2_width 30
		spat2_dopp 0
		*/
		
		spat2_ctl radius 0.1, dist_min 0.5, aperture 30, width 30, warm 30,  bril 30,  prer 75,  revp 30,  env 19,  rev 85,  heav 21,  live 19,  air 0,  doppler 0, az 0, dist 1, pres 90  
		
		; reglage spat3
		/*
		spat3 _dist_min 0.5
		spat3_dist 1
		spat3_az  30
		spat2_pres 90
		spat3_prer 80 ; spat1_ctl fact prer 80
		spat3_revp 30
		spat3_env 19
		spat3_rev 80
		spat3_aperture 30
		spat3_width 30
		spat3_dopp 0
		*/
		
		spat3_ctl radius 0.1, dist_min 0.5, aperture 30, width 30, warm 30,  bril 30,  prer 75,  revp 30,  env 19,  rev 85,  heav 21,  live 19,  air 0,  doppler 0, az 0, dist 1, pres 90  
	 	spat1 100
	 	spat2 100
	 	spat3 100
	 	master 100 100
	 	deltas_pm.pgm 1 ; all zero

	 	spat.clear bang

	 1	print "------- Reset OK "   

NOTE 72 0.5		Reset_done		; begining
		print "Ready ..."