; partita2 Reset 

BPM 121				; Tempo now controlled by BPM command

		// dsp_overdrive 1
		print "Max in overdrive?"
		dsp takeover 1
		fx 100
		3fc_boost 100
		print "------- Reset"

		samplors_ stopall 10
		
		3fc_snd_on 0
		sndfonk_on 0
		
		direct_out.pgm 1
		;	monitors.pgm 1
		
		; cut sons précédents
		son1 0
		son2 0
		son3 0
		
		3fc 0
		synful 0
		Bsynful 0
		sampler1 0
		sampler2 0
		f1 0
		
		; 3fc_snd 0
		3fc_snd_autoplay 0
		3fc_snd_loop 0
		3fc_snd_play 0
		
		3fc_sm_onoff 0
		3fc_sm2_onoff 0
		3fc_sm_ambitus 100
		3fc_sm2_ambitus 100
		
		; cut sigmund analysis
		v1_sigmund 0
		v2_sigmund 0
		al_sigmund 0
		cl_sigmund 0
		
		spat1_traj 0
		spat2_traj 0
		spat3_traj 0
		
		s_loop 0
		s_stop bang ; arrete le string
		s_config 1
		
		s2_loop 0
		s2_stop bang ; arrete le string
		s2_config 1
		evt_3.0 0
		evt_3.0b 0
		evt_3.4 0
		; cut descriptors
	;	descriptors_on 0
		son1 0
		son2 0
		son3 0
		
		master 0
		to_spats wclose ; ferme fenetre graphique spat
		all_off bang   
	 	reset bang ; reset  menu display   

		midifaders BCF2000   
		midifaders_on 1  
		
		v1_fk_on 0
		v2_fk_on 0
		a_fk_on 0
		c_fk_on 0	
		
	 0.5	print "Antescofo setting"   
	
	VARIANCE 0.2
	obs_gate 1 ; cut antescofo observation input   
	
	fx_pgm 1;
	
	; reset synful
	syn_voices 1 xbend 0;   
	syn_voices 2 xbend 0;   
	syn_voices 3 xbend 0;   
	syn_voices 4 xbend 0;   
	syn_voices 5 xbend 0; 
