	synful_flush bang
	Bsynful_flush bang
			
	; reset harmos
	h0 0
	h1 0
	h2 0
	h3 0
	h4 0
	h0_init bang
	h1_init bang
	h2_init bang
	h3_init bang
	h4_init bang
	
